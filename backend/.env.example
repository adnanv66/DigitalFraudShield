# Backend Environment Variables Template (Render / Local)
DATABASE_URL=sqlite:///./fraud_shield.db
# For Production PostgreSQL on Render/Supabase:
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

JWT_SECRET=your_super_strong_random_jwt_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=*
# Or restrict to your Vercel URL in production:
# CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173
